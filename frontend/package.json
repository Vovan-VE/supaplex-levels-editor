{
  "name": "supaplex-levels-editor",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "Supaplex Levels Editor in browser",
  "keywords": [
    "supaplex",
    "megaplex"
  ],
  "author": {
    "name": "Vovan-VE",
    "email": "vovan-ve@yandex.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vovan-VE/supaplex-levels-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Vovan-VE/supaplex-levels-editor/issues"
  },
  "scripts": {
    "analyze": "npm exec --yes -- source-map-explorer@^2 'build/static/js/*.js'",
    "i18n:ci": "i18next-cli extract --ci --dry-run",
    "i18n:extract": "i18next-cli extract",
    "prepare": "npm ls husky > /dev/null && cd .. && husky || exit 0",
    "start": "vite --open",
    "start:wails": "VITE_WAILS=1 vite --port 3017",
    "build": "tsc && vite build",
    "build:wails": "tsc && VITE_WAILS=1 vite build --outDir ./dist-wails",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "tsc && npm run test:unit && npm run test:dependencies && npm run i18n:ci",
    "test:dependencies": "madge -c --warning --ts-config tsconfig.json src/index.tsx",
    "test:types": "tsc",
    "test:unit": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cubux/effector-persistent": "^0.9.0",
    "@cubux/readonly-array": "^3.0.0",
    "@cubux/readonly-map": "^3.0.0",
    "@cubux/readonly-set": "^3.0.0",
    "@cubux/storage-driver": "^0.6.0",
    "@cubux/types": "^3.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.20",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@wailsio/runtime": "^3.0.0-beta.8",
    "classnames": "^2.5.1",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "fast-deep-equal": "^3.1.3",
    "file-saver": "^2.0.5",
    "globals": "^17.11.0",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-range": "^1.10.0",
    "react-select": "^5.10.2",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "i18next-cli": "^1.69.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,cjs,mjs,json,css,scss,md,html}": [
      "prettier --write"
    ]
  },
  "prettier": {}
}
